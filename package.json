{
  "name": "potapov-organic-compounds-lab4",
  "version": "4.0.0",
  "private": true,
  "description": "Потапов Данил ИУ5-54Б — ЛР4 NestJS TypeORM Redis Swagger",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "db:seed": "ts-node scripts/seed.ts",
    "test:e2e": "ts-node test/e2e.ts",
    "start:prod": "node dist/main.js",
    "test:isolated": "node -e \"process.env.TEST_ISOLATED='true';require('ts-node/register');require('./test/e2e')\""
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/typeorm": "10.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.7",
    "minio": "8.0.7",
    "multer": "1.4.5-lts.2",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "@nestjs/swagger": "7.4.2",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "ioredis": "5.4.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "prettier": "3.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@nestjs/testing": "10.4.15",
    "supertest": "7.0.0",
    "@types/supertest": "6.0.2",
    "pg-mem": "3.0.14",
    "ioredis-mock": "8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
