{
  "name": "potapov-organic-compounds-lab2-postgresql",
  "version": "2.1.0",
  "private": true,
  "description": "BMSTU IU5, Lab 2 — organic_compounds, NestJS + PostgreSQL + TypeORM + MinIO",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"views/**/*.hbs\" \"public/**/*.css\"",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "media:download": "bash scripts/download-organic-compounds-media.sh",
    "minio:refresh": "bash scripts/refresh-organic-compounds-minio.sh"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/typeorm": "10.0.2",
    "dotenv": "16.4.7",
    "hbs": "4.2.0",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@types/express": "4.17.21",
    "@types/hbs": "4.0.5",
    "@types/node": "22.10.2",
    "prettier": "3.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
