{
  "info": {
    "_postman_id": "5ee4089d-bae5-4d96-b934-1d1e46785a2b",
    "name": "Organic Compounds Lab 3 — 10 HTTP methods",
    "description": "ЛР3, тема №20. Ровно 10 сохраненных HTTP-методов.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "draftId",
      "value": "0"
    },
    {
      "key": "compoundId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 GET list + filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organic_compounds?carbonCount=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "organic_compounds"
          ],
          "query": [
            {
              "key": "carbonCount",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "02 POST create with image + video",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organic_compounds",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "organic_compounds"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Бутен",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "postman/files/organic_compound.png"
            },
            {
              "key": "video",
              "type": "file",
              "src": "postman/files/organic_compound.webm"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body && body.id) { pm.collectionVariables.set(\"draftId\", body.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 GET draft",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organic_compounds/draft",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "organic_compounds",
            "draft"
          ]
        }
      }
    },
    {
      "name": "04 PUT publish",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/organic_compounds/{{draftId}}/publish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "organic_compounds",
            "{{draftId}}",
            "publish"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shortDescription\": \"Алкен с четырьмя атомами углерода и восемью атомами водорода.\",\n  \"carbonCount\": 4,\n  \"hydrogenCount\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body && body.id) { pm.collectionVariables.set(\"compoundId\", body.id); }"
            ]
          }
        }
      ]
    },
